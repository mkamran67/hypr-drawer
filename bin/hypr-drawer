#!/usr/bin/env bash
# Thin CLI wrapper: hypr-drawer {daemon|toggle|show|hide|extract|quit}
set -euo pipefail

# Hyprland often starts with a minimal PATH that omits ~/.nix-profile/bin
# and ~/.local/bin, which would make `ags` unfindable when this wrapper is
# triggered from a keybind. Prepend the usual user locations so the rest of
# the script doesn't have to care.
PATH="$HOME/.nix-profile/bin:$HOME/.local/bin:/nix/var/nix/profiles/default/bin:$PATH"
export PATH

APP_DIR="${HYPR_DRAWER_APP_DIR:-$HOME/.local/share/hypr-drawer}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-drawer"
LOG="$STATE_DIR/daemon.log"
INSTANCE="hypr-drawer"

mkdir -p "$STATE_DIR"

cmd="${1:-toggle}"

case "$cmd" in
    daemon)
        # Foreground daemon: tee stderr+stdout to the log so `hypr-drawer daemon`
        # still prints to the controlling terminal while leaving a trail behind.
        exec ags run "$APP_DIR/app.ts" --gtk 4 2>&1 | tee -a "$LOG"
        ;;
    quit)
        # Nothing to do if the daemon isn't running — don't cold-start a
        # daemon just to immediately kill it.
        ags request -i "$INSTANCE" quit >/dev/null 2>&1 || true
        ;;
    extract)
        # The drawer is already open when this mouse gesture can target one
        # of its windows, so its daemon must already be running. Keep this
        # request synchronous: it untracks and moves the window before the
        # paired native mouse-drag bind proceeds far enough to be released.
        ags request -i "$INSTANCE" extract >/dev/null
        ;;
    toggle|show|hide)
        # If no daemon is running yet, start it in the background and retry.
        # Daemon stderr lands in $LOG so post-mortem debugging is possible.
        if ! ags request -i "$INSTANCE" "$cmd" >/dev/null 2>&1; then
            setsid ags run "$APP_DIR/app.ts" --gtk 4 >>"$LOG" 2>&1 &
            # Cold-start of gjs from nix store can take a couple seconds; give
            # it up to 10s before declaring failure (Gtk theme parsing on a
            # cold cache occasionally pushes past the old 4s window).
            for _ in $(seq 1 50); do
                sleep 0.2
                ags request -i "$INSTANCE" "$cmd" >/dev/null 2>&1 && exit 0
            done
            echo "hypr-drawer: daemon failed to start. See $LOG" >&2
            exit 1
        fi
        ;;
    *)
        echo "usage: hypr-drawer {daemon|toggle|show|hide|extract|quit}" >&2
        exit 2
        ;;
esac
